<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>ShortP2P.LoRa</RootNamespace>
        <Description>ShortP2P LoRa / Meshtastic transport.</Description>
        <PackageId>ShortP2P.LoRa</PackageId>
        <!-- REQ-CFG-1: X.Y must match the ShortP2P version this binds to. -->
        <Version>0.2.0</Version>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
        <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(ShortP2PRoot)\src\ShortP2P.Transport.Abstractions\ShortP2P.Transport.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ShortP2P.LoRa.Tests" />
    </ItemGroup>

</Project>
